#!/bin/sh
# @APP_NAME@ launcher. PYMOOS2_PYTHON_OVERRIDE changes the interpreter.
PY="${PYMOOS2_PYTHON_OVERRIDE:-@PYMOOS2_PYTHON@}"
@PKG_ROOT_LINE@
export PYTHONPATH="$PKG_ROOT${PYTHONPATH:+:$PYTHONPATH}"
SAFE=""
if "$PY" -P -c "" 2>/dev/null; then
  SAFE="-P"
fi
exec "$PY" $SAFE -m @PKG_NAME@ "$@"
