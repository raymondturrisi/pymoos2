# Version from pymoos2/__init__.py; 0.x matches major.minor, later versions match major.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../__init__.py" _pymoos2_v REGEX "^__version__ *= *\"")
string(REGEX REPLACE "^__version__ *= *\"([^\"]+)\".*" "\\1" PACKAGE_VERSION "${_pymoos2_v}")

set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
  string(REGEX MATCH "^[0-9]+" _pymoos2_major "${PACKAGE_VERSION}")
  string(REGEX MATCH "^[0-9]+\\.[0-9]+" _pymoos2_minor "${PACKAGE_VERSION}")
  if(PACKAGE_FIND_VERSION_MAJOR EQUAL 0)
    if(_pymoos2_minor VERSION_EQUAL "0.${PACKAGE_FIND_VERSION_MINOR}")
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
  elseif(_pymoos2_major EQUAL PACKAGE_FIND_VERSION_MAJOR)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
endif()
if(PACKAGE_FIND_VERSION AND PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_EXACT TRUE)
endif()
